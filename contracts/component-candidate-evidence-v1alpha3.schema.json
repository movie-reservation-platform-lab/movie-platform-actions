{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.movie-platform.dev/ci/component-candidate-evidence-v1alpha3.schema.json",
  "title": "ComponentCandidateEvidence v1alpha3",
  "description": "Emitted with explicit v1alpha3 selection. Four-file evidence with original vulnerability counts and signed governed decisions. Referenced v1alpha2 constraints remain immutable; semantic recomputation and trusted policy-source validation are mandatory.",
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "ci.movie-platform.dev/v1alpha3"
    },
    "kind": {
      "$ref": "https://schemas.movie-platform.dev/ci/component-candidate-evidence-v1alpha2.schema.json#/properties/kind"
    },
    "component": {
      "anyOf": [
        {
          "$ref": "https://schemas.movie-platform.dev/ci/component-candidate-evidence-v1alpha2.schema.json#/properties/component"
        },
        {
          "type": "string",
          "const": "reservation-service"
        }
      ]
    },
    "source": {
      "$ref": "https://schemas.movie-platform.dev/ci/component-candidate-evidence-v1alpha2.schema.json#/properties/source"
    },
    "workflow": {
      "$ref": "https://schemas.movie-platform.dev/ci/component-candidate-evidence-v1alpha2.schema.json#/properties/workflow"
    },
    "candidate": {
      "$ref": "https://schemas.movie-platform.dev/ci/component-candidate-evidence-v1alpha2.schema.json#/properties/candidate"
    },
    "provenance": {
      "$ref": "https://schemas.movie-platform.dev/ci/component-candidate-evidence-v1alpha2.schema.json#/properties/provenance"
    },
    "securityEvidence": {
      "type": "object",
      "properties": {
        "artifactName": {
          "$ref": "https://schemas.movie-platform.dev/ci/component-candidate-evidence-v1alpha2.schema.json#/properties/securityEvidence/properties/artifactName"
        },
        "sbom": {
          "$ref": "https://schemas.movie-platform.dev/ci/component-candidate-evidence-v1alpha2.schema.json#/properties/securityEvidence/properties/sbom"
        },
        "vulnerabilities": {
          "$ref": "https://schemas.movie-platform.dev/ci/component-candidate-evidence-v1alpha2.schema.json#/properties/securityEvidence/properties/vulnerabilities"
        },
        "vulnerabilityPolicy": {
          "type": "object",
          "properties": {
            "source": {
              "type": "object",
              "properties": {
                "repository": {
                  "const": "movie-reservation-platform-lab/movie-platform-actions"
                },
                "revision": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                }
              },
              "required": [
                "repository",
                "revision"
              ],
              "additionalProperties": false
            },
            "reportSha256": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "evaluation": {
              "$ref": "#/$defs/evaluation"
            }
          },
          "required": [
            "source",
            "reportSha256",
            "evaluation"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "artifactName",
        "sbom",
        "vulnerabilities",
        "vulnerabilityPolicy"
      ],
      "additionalProperties": false
    },
    "generatedAt": {
      "$ref": "https://schemas.movie-platform.dev/ci/component-candidate-evidence-v1alpha2.schema.json#/properties/generatedAt"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "component",
    "source",
    "workflow",
    "candidate",
    "provenance",
    "securityEvidence",
    "generatedAt"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "$ref": "https://schemas.movie-platform.dev/ci/component-candidate-evidence-v1alpha2.schema.json#/allOf/0"
    },
    {
      "$ref": "https://schemas.movie-platform.dev/ci/component-candidate-evidence-v1alpha2.schema.json#/allOf/1"
    },
    {
      "$ref": "https://schemas.movie-platform.dev/ci/component-candidate-evidence-v1alpha2.schema.json#/allOf/2"
    },
    {
      "$ref": "https://schemas.movie-platform.dev/ci/component-candidate-evidence-v1alpha2.schema.json#/allOf/3"
    },
    {
      "$ref": "https://schemas.movie-platform.dev/ci/component-candidate-evidence-v1alpha2.schema.json#/allOf/4"
    },
    {
      "if": {
        "properties": {
          "component": {
            "const": "reservation-service"
          }
        }
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "repository": {
                "const": "movie-reservation-platform-lab/movie-reservation-service"
              }
            }
          },
          "candidate": {
            "properties": {
              "repository": {
                "const": "ghcr.io/movie-reservation-platform-lab/movie-reservation-service"
              }
            }
          },
          "workflow": {
            "properties": {
              "job": {
                "const": "publish-candidate"
              }
            }
          },
          "provenance": {
            "properties": {
              "subjectName": {
                "const": "ghcr.io/movie-reservation-platform-lab/movie-reservation-service"
              },
              "bundle": {
                "properties": {
                  "path": {
                    "const": "security-evidence/reservation-service-provenance.json"
                  }
                }
              }
            }
          },
          "securityEvidence": {
            "properties": {
              "sbom": {
                "properties": {
                  "path": {
                    "const": "security-evidence/reservation-service.cdx.json"
                  }
                }
              },
              "vulnerabilities": {
                "properties": {
                  "path": {
                    "const": "security-evidence/reservation-service-vulnerabilities.json"
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "evaluation": {
      "type": "object",
      "properties": {
        "evaluatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "mode": {
          "enum": [
            "strict",
            "approved-exemptions"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?$"
        },
        "counts": {
          "type": "object",
          "properties": {
            "unknown": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "low": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "medium": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "high": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "critical": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            }
          },
          "required": [
            "unknown",
            "low",
            "medium",
            "high",
            "critical"
          ],
          "additionalProperties": false
        },
        "exempted": {
          "type": "object",
          "properties": {
            "notAffected": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "riskAccepted": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            }
          },
          "required": [
            "notAffected",
            "riskAccepted"
          ],
          "additionalProperties": false
        },
        "blockingCritical": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "result": {
          "enum": [
            "passed",
            "passed-with-exemptions",
            "failed"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pointer": {
                "type": "string",
                "pattern": "^/Results/[0-9]+/Vulnerabilities/[0-9]+$"
              },
              "vulnerabilityId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?$"
              },
              "package": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?$"
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?$"
                  },
                  "purl": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048,
                        "pattern": "^pkg:[a-z][a-z0-9.+-]*/[^@?#\\s*\\\\]+@[^@?#\\s*\\\\]+(?:\\?[^#\\s*\\\\]+)?$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "name",
                  "version",
                  "purl"
                ],
                "additionalProperties": false
              },
              "severity": {
                "enum": [
                  "UNKNOWN",
                  "LOW",
                  "MEDIUM",
                  "HIGH",
                  "CRITICAL"
                ]
              },
              "disposition": {
                "enum": [
                  "non-blocking",
                  "blocking",
                  "not-affected",
                  "risk-accepted"
                ]
              },
              "exemptionId": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 64,
                    "pattern": "^EX-[A-Za-z0-9][A-Za-z0-9-]{0,60}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "pointer",
              "vulnerabilityId",
              "package",
              "severity",
              "disposition",
              "exemptionId"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "disposition": {
                      "enum": [
                        "not-affected",
                        "risk-accepted"
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "severity": {
                      "const": "CRITICAL"
                    },
                    "exemptionId": {
                      "type": "string",
                      "maxLength": 64,
                      "pattern": "^EX-[A-Za-z0-9][A-Za-z0-9-]{0,60}$"
                    },
                    "package": {
                      "properties": {
                        "purl": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2048,
                          "pattern": "^pkg:[a-z][a-z0-9.+-]*/[^@?#\\s*\\\\]+@[^@?#\\s*\\\\]+(?:\\?[^#\\s*\\\\]+)?$"
                        }
                      }
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "disposition": {
                      "enum": [
                        "blocking",
                        "non-blocking"
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "exemptionId": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "disposition": {
                      "const": "blocking"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "severity": {
                      "const": "CRITICAL"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "disposition": {
                      "const": "non-blocking"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "severity": {
                      "enum": [
                        "UNKNOWN",
                        "LOW",
                        "MEDIUM",
                        "HIGH"
                      ]
                    }
                  }
                }
              }
            ]
          },
          "minItems": 0,
          "maxItems": 10000
        },
        "exemptions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "record": {
                "$ref": "https://schemas.movie-platform.dev/ci/container-vulnerability-exemption-v1alpha1.schema.json"
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            },
            "required": [
              "record",
              "sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 128
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "enum": [
                  "exemption-applied",
                  "expires-soon",
                  "unused-exemption",
                  "unused-expired-exemption",
                  "expired-exemption"
                ]
              },
              "exemptionId": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^EX-[A-Za-z0-9][A-Za-z0-9-]{0,60}$"
              }
            },
            "required": [
              "code",
              "exemptionId"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 256
        }
      },
      "required": [
        "evaluatedAt",
        "mode",
        "subject",
        "counts",
        "exempted",
        "blockingCritical",
        "result",
        "findings",
        "exemptions",
        "warnings"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {
                "const": "passed"
              }
            }
          },
          "then": {
            "properties": {
              "blockingCritical": {
                "const": 0
              },
              "exempted": {
                "properties": {
                  "notAffected": {
                    "const": 0
                  },
                  "riskAccepted": {
                    "const": 0
                  }
                }
              },
              "exemptions": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "result": {
                "const": "passed-with-exemptions"
              }
            }
          },
          "then": {
            "properties": {
              "mode": {
                "const": "approved-exemptions"
              },
              "blockingCritical": {
                "const": 0
              },
              "exemptions": {
                "minItems": 1
              }
            },
            "anyOf": [
              {
                "properties": {
                  "exempted": {
                    "properties": {
                      "notAffected": {
                        "minimum": 1
                      }
                    }
                  }
                }
              },
              {
                "properties": {
                  "exempted": {
                    "properties": {
                      "riskAccepted": {
                        "minimum": 1
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "result": {
                "const": "failed"
              }
            }
          },
          "then": {
            "properties": {
              "blockingCritical": {
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "strict"
              }
            }
          },
          "then": {
            "properties": {
              "exempted": {
                "properties": {
                  "notAffected": {
                    "const": 0
                  },
                  "riskAccepted": {
                    "const": 0
                  }
                }
              },
              "exemptions": {
                "maxItems": 0
              },
              "warnings": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
